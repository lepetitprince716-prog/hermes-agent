{
  "name": "hermes-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Hermes Mobile — Capacitor shell照抄 apps/desktop",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -p . --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src/",
    "cap:init": "npx cap init HermesMobile com.nousresearch.hermes --web-dir=dist",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@hermes/shared": "file:../shared",
    "@nanostores/react": "1.1.0",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-virtual": "3.14.6",
    "clsx": "2.1.1",
    "dompurify": "3.4.13",
    "frimousse": "0.3.0",
    "katex": "0.16.47",
    "mermaid": "11.16.1",
    "motion": "12.42.2",
    "nanostores": "1.4.0",
    "radix-ui": "1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@capacitor/ios": "6.2.1",
    "@capacitor/android": "6.2.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
